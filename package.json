{
  "name": "doctor-scheduler",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:infra": "docker compose up -d --wait",
    "down:infra": "docker compose down",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:materialize": "npm run materialize -w @ds/booking-api",
    "search:reindex": "npm run reindex -w @ds/workers",
    "dev": "concurrently -n api,web,workers -c blue,green,magenta \"npm run dev -w @ds/booking-api\" \"npm run dev -w @ds/web\" \"npm run dev -w @ds/workers\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "demo:race": "tsx scripts/race.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
